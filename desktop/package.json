{
  "name": "pcmaker-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Tray app that monitors PCPrice.lk sync health and runs the scrape pipeline locally",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "probe": "node scripts/probe.mjs",
    "start": "npm run build && electron .",
    "icons": "node scripts/icons.mjs",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-shortcut.ps1",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "electron": "^44.3.0",
    "esbuild": "^0.25.12"
  }
}
