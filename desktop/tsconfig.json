{
  // The root tsconfig excludes desktop/: Electron is installed only in
  // desktop/node_modules, so on Vercel, where only the site's dependencies
  // exist, every `import ... from 'electron'` failed the website's build.
  // This config typechecks the desktop app on its own, where Electron is.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "incremental": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
