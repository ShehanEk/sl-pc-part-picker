# Pooled connection — used by the app at runtime (Neon Dashboard → Connect → pooled)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct connection — used by drizzle-kit for migrations (same host without `-pooler`)
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Used by the normalizer to map messy listing titles to canonical part_ids
ANTHROPIC_API_KEY=""

# --- Admin dashboard (/admin) ---------------------------------------------
# One password for the single operator. Use 32+ random characters: there is no
# rate limiting, because a serverless deployment resets in-memory counters on
# every cold start and a counter that resets is theatre, not a control.
ADMIN_PASSWORD=""
# Signs the session cookie. Any 32+ random string. Changing it signs everyone out.
ADMIN_SESSION_SECRET=""

# Lets the nightly normalize job clear the 'catalog' cache when it finishes,
# instead of the site serving up to 30-minute-old prices.
REVALIDATE_SECRET=""
